#
# Qwen3.5-35B-A3B on 2 GPU nodes (1 trainer + 1 rollout), 16 prompts x 8 generations = 128 trajectories per step on
# R2E-Gym Easy. The two 35B profiles are sized so that eight of them (JOB_SUFFIX=a..h) fill the same 16 GPU nodes
# as one 397B profile and together generate as many trajectories per step: 8 x 128 = 1,024 (397b-easy).
MODEL_ID=Qwen/Qwen3.5-35B-A3B
NNODES_TRAIN=1
NNODES_ROLLOUT=1
TRAIN_TP=2
TRAIN_CP=1
TRAIN_PP=2
TRAIN_EP=4
PP_EDGE_LAYERS=20   # uneven first/last pipeline stage; empty = computed from the layer count
PARAM_OFFLOAD=True
ROLLOUT_TP=2
ROLLOUT_DP=1
ROLLOUT_EP=1
ROLLOUT_QUANT=fp8
ROLLOUT_GPU_MEM_UTIL=0.8
ROLLOUT_MAX_BATCHED_TOKENS=16384
ROLLOUT_MAX_NUM_SEQS=256   # sequences vLLM admits per replica; the rest queue inside vLLM
PROMPT_LENGTH=8192
RESPONSE_LENGTH=32768
AGENT_MAX_STEPS=100
MASK_UNFINISHED_EPISODE=False   # 32K budget: most episodes are unfinished, keep their tokens (README: Unfinished episodes)
TRAIN_BATCH=16
MINI_BATCH=8
SYNC_STEP=2
ROLLOUT_N=8
SESSIONS=128   # = min(TRAIN_BATCH x ROLLOUT_N, replicas x ROLLOUT_MAX_NUM_SEQS): surplus trajectories wait in uni-agent, not inside vLLM
GATEWAYS=2
AGENT_WORKERS=2
TOTAL_STEPS=2
SESSION_TIMEOUT_S=7200
SANDBOX_START_WAIT_S=1800
SANDBOX_STARTUP_CONCURRENCY=64   # job-wide gate on environment start-ups; SESSIONS / this x start latency (20-45 s warm) < SANDBOX_START_WAIT_S
RAY_CPUS=96   # Ray CPU slots per node >= SESSIONS / GPU nodes (every session is a Ray task)
TRAIN_SOURCE=r2e_gym_easy
TRAIN_DATASET=
TRAIN_SPLIT=train
TRAIN_SEED=0
TRAIN_INSTANCES=128   # >= TOTAL_STEPS x TRAIN_BATCH so prompts do not repeat within a run
VAL_TASKS=20
ATE_TEMPLATE=swe-1c4g   # Substrate actor template (booking per environment); must exist (README, Run step 1)
MEM_REQUEST=700Gi
EPH_REQUEST=300Gi   # ephemeral storage per GPU pod for the checkpoint
