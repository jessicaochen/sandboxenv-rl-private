#
# Qwen3.5-397B-A17B on 16 GPU nodes (8 trainer TP2 PP8 EP8 + 8 FP8 TP8 replicas) at smoke load: 16 prompts x 8 generations,
# 2 steps + validation. Exercises the whole 397B path (FP8 refit, pipeline split, offload, Substrate) in the shortest run;
# run it green before 397b-easy / 397b-v1.
MODEL_ID=Qwen/Qwen3.5-397B-A17B
NNODES_TRAIN=8
NNODES_ROLLOUT=8
TRAIN_TP=2
TRAIN_CP=1
TRAIN_PP=8
TRAIN_EP=8
PP_EDGE_LAYERS=   # uneven first/last pipeline stage; empty = computed from the layer count
PARAM_OFFLOAD=True
ROLLOUT_TP=8
ROLLOUT_DP=1
ROLLOUT_EP=1
ROLLOUT_QUANT=fp8
ROLLOUT_GPU_MEM_UTIL=0.85
ROLLOUT_MAX_BATCHED_TOKENS=16384
ROLLOUT_MAX_NUM_SEQS=256   # sequences vLLM admits per replica; the rest queue inside vLLM
PROMPT_LENGTH=8192
RESPONSE_LENGTH=32768
AGENT_MAX_STEPS=100
MASK_UNFINISHED_EPISODE=False   # 32K budget: most episodes are unfinished, keep their tokens (README: Unfinished episodes)
TRAIN_BATCH=16
MINI_BATCH=8
SYNC_STEP=2
ROLLOUT_N=8
SESSIONS=128   # = min(TRAIN_BATCH x ROLLOUT_N, replicas x ROLLOUT_MAX_NUM_SEQS): surplus trajectories wait in uni-agent, not inside vLLM
GATEWAYS=2
AGENT_WORKERS=2
TOTAL_STEPS=2
SESSION_TIMEOUT_S=7200
SANDBOX_START_WAIT_S=1800
SANDBOX_STARTUP_CONCURRENCY=32   # job-wide gate on environment start-ups; SESSIONS / this x start latency (20-45 s warm) < SANDBOX_START_WAIT_S
RAY_CPUS=64   # Ray CPU slots per node >= SESSIONS / GPU nodes (every session is a Ray task)
TRAIN_SOURCE=r2e_gym
TRAIN_DATASET=R2E-Gym/R2E-Gym-V1
TRAIN_SPLIT=train
TRAIN_SEED=0
TRAIN_INSTANCES=64   # >= TOTAL_STEPS x TRAIN_BATCH so prompts do not repeat within a run
VAL_TASKS=20
ATE_TEMPLATE=swe-1c4g   # Substrate actor template (booking per environment); must exist (README, Run step 1)
MEM_REQUEST=900Gi
EPH_REQUEST=1000Gi   # ephemeral storage per GPU pod for the checkpoint
